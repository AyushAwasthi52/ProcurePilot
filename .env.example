# Application
NODE_ENV=development
APP_URL=http://localhost:3000
AUTH_SECRET=procurepilot-development-secret-change-in-production-min32chars
DATABASE_URL="postgresql://procurepilot:procurepilot_dev@localhost:5432/procurepilot?schema=public"
DIRECT_URL="postgresql://procurepilot:procurepilot_dev@localhost:5432/procurepilot?schema=public"

# AI Configuration (mock, gemini, openai)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_MAX_COST_PER_REQUEST_USD=0.25

# Product Discovery Providers (all, seeded, provider_a, provider_b)
PRODUCT_PROVIDER=all
PRODUCT_PROVIDER_API_KEY=
PROVIDER_A_ENDPOINT=
PROVIDER_A_API_KEY=
PROVIDER_B_ENDPOINT=
PROVIDER_B_API_KEY=
PROVIDER_MODE=demo
PROVIDER_TIMEOUT_MS=6000
OFFER_CACHE_TTL_SECONDS=900

# Purchase Plan & Approval
PLAN_TTL_SECONDS=600

# PayPal Configuration (Server-Side Only - never leak client secret)
# If PAYMENTS_SIMULATED is false, PAYPAL_CLIENT_ID and PAYPAL_CLIENT_SECRET are required
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYMENTS_SIMULATED=true

# Observability & Logging (debug, info, warn, error)
LOG_LEVEL=info
ERROR_TRACKING_DSN=
